# ---- 缓存 / 本地化目录（随项目走，不入库）----
.cache-local/

# ---- Python ----
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Jupyter ----
.ipynb_checkpoints/
*.nbconvert.ipynb

# ---- 模型权重 / 大数据（体积大，不入库）----
checkpoints/*
!checkpoints/.gitkeep
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.etli
*.npz
*.h5

# ---- 数据集（体积大，只留 dataset/README.md 记录来源）----
dataset/*
!dataset/README.md

# ---- 训练 / 运行产物 ----
wandb/
runs/
outputs/
logs/
*.log
# 用 data/* 而非 data/：git 不会进入被忽略的目录，
# 写成 data/ 会让下面的 !data/eval 否定规则失效。
data/*
datasets/

# ---- 环境 / 凭据（绝不入库）----
.env
.env.*
*.key
secrets/
credentials*
.git-credentials
*.token

# ---- 第三方运行时产生的垃圾 ----
MUJOCO_LOG.TXT

# ---- 编辑器 / 系统 ----
.DS_Store
.idea/
.vscode/
*.swp

# ---- 第三方权重（体积大，见各自 README 重建）----
third_party/groundingdino_weights/*.pth
third_party/groundingdino_weights/bert-base-uncased/

# ---- 评测结果：只存 summary.json（文本、可复现分析），不存视频 ----
!data/eval/
data/eval/*/videos/
data/eval/*/*.mp4
# ablation_* 也入库（消融结果，text 很小）

# ---- 版本化契约文件（角色清单 + 接触分类契约，需 hash 追溯，必须入库）----
!data/task_object_role_manifest.json
!data/collision_event_contract_v2.json
# ---- 接触审计输出（Step 4+ 汇总结果，需 hash 追溯）----
!data/audit/

# ---- 调试产物 / 备份（一次性探索输出，不入库）----
data/audit/*.json.bak_*
data/eval/*/*.bak_polluted
data/eval/*/*.bak_*
*.bak
*.bak_*

# ---- 打包产物（体积大，由源码重建）----
*.tar.gz
*.zip

# ---- 审计目录下的调试 json（只保留正式 .md 结论与关键 .json 契约）----
data/audit/*_gate.json
data/audit/*_replay.json
data/audit/*_detection.json
data/audit/*_verify.json
data/audit/*_baseline.json
data/audit/*_sensitivity.json
data/audit/*_frequency.json
data/audit/*_w1.json
data/audit/*_w2.json
data/audit/indirect_propagation_*.json
data/audit/success_value_probe_gate*.json
data/audit/quat_fix_verify.json
data/audit/mug_static_drift_baseline.json

# ---- 旧运行目录（历史会话临时产物，不入库）----
safeVLA_round3/

