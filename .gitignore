# ---- 缓存 / 本地化目录（随项目走，不入库）----
.cache-local/

# ---- Python ----
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Jupyter ----
.ipynb_checkpoints/
*.nbconvert.ipynb

# ---- 模型权重 / 大数据（体积大，不入库）----
checkpoints/*
!checkpoints/.gitkeep
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.etli
*.npz
*.h5

# ---- 训练 / 运行产物 ----
wandb/
runs/
outputs/
logs/
*.log
data/
datasets/

# ---- 环境 / 凭据（绝不入库）----
.env
.env.*
*.key
secrets/
credentials*

# ---- 编辑器 / 系统 ----
.DS_Store
.idea/
.vscode/
*.swp
