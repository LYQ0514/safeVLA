# ---- 缓存 / 本地化目录（随项目走，不入库）----
.cache-local/

# ---- Python ----
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Jupyter ----
.ipynb_checkpoints/
*.nbconvert.ipynb

# ---- 模型权重 / 大数据（体积大，不入库）----
checkpoints/*
!checkpoints/.gitkeep
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.etli
*.npz
*.h5

# ---- 数据集（体积大，只留 dataset/README.md 记录来源）----
dataset/*
!dataset/README.md

# ---- 训练 / 运行产物 ----
wandb/
runs/
outputs/
logs/
*.log
# 用 data/* 而非 data/：git 不会进入被忽略的目录，
# 写成 data/ 会让下面的 !data/eval 否定规则失效。
data/*
datasets/

# ---- 环境 / 凭据（绝不入库）----
.env
.env.*
*.key
secrets/
credentials*
.git-credentials
*.token

# ---- 第三方运行时产生的垃圾 ----
MUJOCO_LOG.TXT

# ---- 编辑器 / 系统 ----
.DS_Store
.idea/
.vscode/
*.swp

# ---- 第三方权重（体积大，见各自 README 重建）----
third_party/groundingdino_weights/*.pth
third_party/groundingdino_weights/bert-base-uncased/

# ---- 评测结果：只存 summary.json（文本、可复现分析），不存视频 ----
!data/eval/
data/eval/*/videos/
data/eval/*/*.mp4
# ablation_* 也入库（消融结果，text 很小）

# ---- 版本化契约文件（角色清单 + 接触分类契约，需 hash 追溯，必须入库）----
!data/task_object_role_manifest.json
!data/collision_event_contract_v2.json

